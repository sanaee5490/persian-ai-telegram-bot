# ============================================
#  تنظیمات بات هوش مصنوعی تلگرام
#  این فایل را کپی کنید: cp .env.example .env
# ============================================

# --- توکن ربات (الزامی) ---
# از @BotFather بگیرید: /newbot
BOT_TOKEN=

# --- آی‌دی عددی ادمین‌ها (با کاما جدا کنید) ---
# آی‌دی خودتان را از @userinfobot بگیرید
ADMIN_IDS=

# --- ارائه‌دهنده هوش مصنوعی ---
# auto | gemini | openrouter
AI_PROVIDER=auto

# --- کلید Google AI Studio (رایگان) ---
# از https://aistudio.google.com/apikey بگیرید
GEMINI_API_KEY=

# --- کلید OpenRouter (رایگان) ---
# از https://openrouter.ai/keys بگیرید
OPENROUTER_API_KEY=

# --- مدل پیش‌فرض ---
DEFAULT_MODEL=gemini-3.8-flash

# --- شخصیت دستیار ---
SYSTEM_PROMPT=شما یک دستیار هوش مصنوعی فارسی‌زبان، باهوش و مودب هستید. همیشه به فارسی روان و طبیعی پاسخ دهید. پاسخ‌ها را کوتاه، دقیق و کاربردی بنویسید. از ایموجی به‌صورت متعادل استفاده کنید.

# --- پارامترهای مدل ---
TEMPERATURE=0.7
MAX_TOKENS=2048
MAX_HISTORY=12

# --- محدودیت نرخ ---
RATE_LIMIT_PER_MINUTE=15

# --- جستجوی وب رایگان (DuckDuckGo) ---
ENABLE_WEB_SEARCH=true

# --- پورت داشبورد وب ---
PORT=3000

# --- آدرس عمومی (برای مینی‌اپ) ---
PUBLIC_URL=http://localhost:3000

# --- مسیر دیتابیس ---
DB_PATH=./data/bot.db
